# Copy to ads/.env.local. Never commit the populated file.

# Yandex Direct and Metrica
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_DIRECT_TOKEN=
YANDEX_LOGIN=
YANDEX_METRIKA_COUNTER_ID=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Safety gates. Read-only is the only permitted default.
ADS_API_MODE=read_only
ADS_ALLOW_ACCOUNT_WRITES=false
ADS_ALLOW_SPEND=false
